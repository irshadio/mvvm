# Environment configuration consumed by `envied` (see lib/core/config/app_config.dart).
# Regenerate after editing:  dart run build_runner build
#
# NOTE: this template's value is a PUBLIC API URL (not a secret), so `.env` is
# committed for out-of-the-box builds. For real secrets:
#   1) `git rm --cached .env` and add `.env` to .gitignore
#   2) set `@EnviedField(obfuscate: true)` in app_config.dart
API_BASE_URL=https://jsonplaceholder.typicode.com
